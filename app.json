{
  "expo": {
    "name": "Budżet domowy",
    "slug": "balancey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "budzetdomowy",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F13",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.igor.budzetdomowy",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Odblokowanie aplikacji budżetu za pomocą Face ID."
      }
    },
    "android": {
      "package": "com.igor.budzetdomowy",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#22C55E",
          "defaultChannel": "budget"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Odblokowanie aplikacji budżetu za pomocą Face ID."
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Aparat jest potrzebny do skanowania paragonów. Zdjęcie jest odczytywane na urządzeniu i nie opuszcza telefonu.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be07e724-493f-4206-9914-c65a5e0191b5"
      }
    },
    "owner": "saokas-team",
    "updates": {
      "url": "https://u.expo.dev/be07e724-493f-4206-9914-c65a5e0191b5"
    }
  }
}
