{
  "expo": {
    "name": "Budżet domowy",
    "slug": "budzet-domowy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "budzetdomowy",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F13",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.igor.budzetdomowy",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Odblokowanie aplikacji budżetu za pomocą Face ID."
      }
    },
    "android": {
      "package": "com.igor.budzetdomowy",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#22C55E",
          "defaultChannel": "budget"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Odblokowanie aplikacji budżetu za pomocą Face ID."
        }
      ],
      "expo-font"
    ]
  }
}
